{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "test": "tsc -p tsconfig.test.json && TSX_TSCONFIG_PATH=tsconfig.test.json node --import tsx --test tests/*.test.ts tests/*.test.tsx",
    "deadcode": "knip",
    "dupes": "cd .. && jscpd --baseline .jscpd-baseline.json --fail-on-new-clones",
    "dupes:baseline": "cd .. && jscpd --baseline .jscpd-baseline.json --update-baseline",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "happy-dom": "^21.0.4",
    "jscpd": "^5.4.1",
    "knip": "^6.41.0",
    "oxlint": "^1.75.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "vite": "^8.2.0"
  }
}
